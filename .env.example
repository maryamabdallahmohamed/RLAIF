# Copy to .env and fill in. .env is gitignored.

# Ollama Cloud — used by Critic (Member B) and Judge (Member C)
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
OLLAMA_URL=https://ollama.com
CRITIC_MODEL=gpt-oss:20b-cloud
JUDGE_MODEL=gpt-oss:120b-cloud

# HuggingFace — for dataset downloads (UltraFeedback, smoltalk)
# Only needed if a dataset is gated; UltraFeedback and smoltalk are public.
# HF_TOKEN=
